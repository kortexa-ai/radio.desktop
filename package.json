{
    "name": "radio-desktop",
    "version": "1.0.0",
    "type": "module",
    "description": "AI Music Generation Desktop App powered by ACE-Step",
    "scripts": {
        "start": "vite build && electrobun dev",
        "dev": "electrobun dev --watch",
        "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
        "hmr": "vite --port 5173",
        "build:canary": "vite build && electrobun build --env=canary",
        "build:stable": "vite build && electrobun build --env=stable"
    },
    "dependencies": {
        "electrobun": "1.18.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/bun": "^1.3.14",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/three": "^0.185.4",
        "@vitejs/plugin-react": "^6.0.5",
        "autoprefixer": "^10.5.4",
        "concurrently": "^10.0.4",
        "postcss": "^8.5.26",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.2.1"
    }
}
